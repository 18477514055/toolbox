<Window x:Class="Toolbox.Shell.FloatingWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面工具箱"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual">

    <!--
        ⛔ 铁律：这个窗口绝不能抢焦点。
        ShowActivated="False" 只保证「显示时不激活」，**点击仍然会激活**，
        所以代码里还会补上 WS_EX_NOACTIVATE（见 OnSourceInitialized）。
        AI 工具的「读当前页面」完全依赖这一点——一抢焦点就会读到悬浮窗自己。
    -->
    <Border x:Name="ShellBorder"
            CornerRadius="12"
            Background="#EAF7F9FC"
            BorderBrush="#26000000"
            BorderThickness="1"
            Padding="5">
        <StackPanel>

            <!-- 拖动柄 -->
            <Border x:Name="DragHandle"
                    Height="20"
                    Background="Transparent"
                    Cursor="SizeAll">
                <TextBlock Text="✥"
                           FontSize="11"
                           Foreground="#8A94A6"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <!-- 工具按钮（代码生成，按设置可裁剪） -->
            <StackPanel x:Name="ToolHost" />

            <Border x:Name="Separator" Height="1" Background="#1A000000" Margin="5,5" />

            <!-- 设置 / 收起 -->
            <StackPanel x:Name="FooterHost" />

        </StackPanel>
    </Border>
</Window>

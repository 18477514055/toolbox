<Window x:Class="Toolbox.Tools.BatchRename.BatchRenameWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量文件重命名"
        Width="980" Height="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        Background="#FFF6F7F9">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 目录 -->
            <RowDefinition Height="Auto" />   <!-- 规则 -->
            <RowDefinition Height="*" />      <!-- 预览 -->
            <RowDefinition Height="Auto" />   <!-- 状态 + 按钮 -->
        </Grid.RowDefinitions>

        <!-- ===== 目录选择 ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="目录" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="DirBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center" />
            <Button x:Name="BrowseDirBtn" Grid.Column="2" Content="浏览…" Width="76" Height="28" Margin="8,0,0,0" />
            <Button x:Name="LoadDirBtn" Grid.Column="3" Content="载入" Width="76" Height="28" Margin="8,0,0,0" />
        </Grid>

        <!-- ===== 规则 ===== -->
        <GroupBox Grid.Row="1" Header="改名规则" Margin="0,12,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 行1：前缀 / 后缀 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="前缀" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="PrefixBox" Grid.Row="0" Grid.Column="1" Height="26"
                         VerticalContentAlignment="Center" ToolTip="加在文件名最前面" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="后缀" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox x:Name="SuffixBox" Grid.Row="0" Grid.Column="3" Height="26"
                         VerticalContentAlignment="Center" ToolTip="加在扩展名之前" />

                <CheckBox x:Name="LowerExtBox" Grid.Row="0" Grid.Column="5"
                          Content="扩展名转小写" VerticalAlignment="Center" Margin="16,0,0,0" />

                <!-- 行2：替换 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="替换" VerticalAlignment="Center" Margin="0,8,6,0" />
                <TextBox x:Name="FindBox" Grid.Row="1" Grid.Column="1" Height="26" Margin="0,8,0,0"
                         VerticalContentAlignment="Center" ToolTip="要查找的文字（留空 = 不替换）" />

                <TextBlock Grid.Row="1" Grid.Column="2" Text="为" VerticalAlignment="Center" Margin="16,8,6,0" />
                <TextBox x:Name="ReplaceBox" Grid.Row="1" Grid.Column="3" Height="26" Margin="0,8,0,0"
                         VerticalContentAlignment="Center" ToolTip="替换成什么（可以留空 = 删除）" />

                <CheckBox x:Name="MatchCaseBox" Grid.Row="1" Grid.Column="5"
                          Content="区分大小写" VerticalAlignment="Center" Margin="16,8,0,0" />

                <!-- 行3：序号 + 时间戳 -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6"
                            Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="SeqBox" Content="序号" VerticalAlignment="Center" />
                    <TextBlock Text="起始" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBox x:Name="SeqStartBox" Width="52" Height="26" Text="1" VerticalContentAlignment="Center" />
                    <TextBlock Text="位数" VerticalAlignment="Center" Margin="10,0,4,0" />
                    <TextBox x:Name="SeqPadBox" Width="44" Height="26" Text="3" VerticalContentAlignment="Center" />
                    <TextBlock Text="步长" VerticalAlignment="Center" Margin="10,0,4,0" />
                    <TextBox x:Name="SeqStepBox" Width="44" Height="26" Text="1" VerticalContentAlignment="Center" />

                    <Separator Style="{x:Null}" Width="1" Margin="16,4,16,4" Background="#FFD5D9E0" />

                    <CheckBox x:Name="TsBox" Content="时间戳" VerticalAlignment="Center" />
                    <TextBox x:Name="TsFormatBox" Width="104" Height="26" Margin="8,0,0,0"
                             Text="yyyyMMdd" VerticalContentAlignment="Center"
                             ToolTip=".NET 日期格式，例如 yyyyMMdd / yyyy-MM-dd_HHmmss" />
                    <ComboBox x:Name="TsSourceCombo" Width="128" Height="26" Margin="8,0,0,0" SelectedIndex="0">
                        <ComboBoxItem Content="用文件修改时间" />
                        <ComboBoxItem Content="用当前时间" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ===== 预览 ===== -->
        <GroupBox Grid.Row="2" Header="预览（确认无误再点执行）" Margin="0,12,0,0" Padding="8">
            <DataGrid x:Name="PreviewGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="原名" Binding="{Binding SourceName}" Width="*" />
                    <DataGridTextColumn Header="新名" Binding="{Binding TargetName}" Width="*" />
                    <DataGridTextColumn Header="说明" Binding="{Binding Status}" Width="240" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- ===== 底部 ===== -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="SummaryText" Text="选择一个目录开始。" Foreground="#FF1F2329" />
                <TextBlock x:Name="HintText" Foreground="#FF8A94A6" FontSize="12"
                           Text="先看预览里的「新名」和「说明」，确认无误再执行。" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="UndoBtn" Content="撤销上次改名" Width="116" Height="32" Margin="0,0,8,0" />
                <Button x:Name="ApplyBtn" Content="执行改名" Width="96" Height="32" Margin="0,0,8,0" />
                <Button x:Name="CloseBtn" Content="关闭" Width="76" Height="32" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

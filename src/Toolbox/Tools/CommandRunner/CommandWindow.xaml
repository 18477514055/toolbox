<Window x:Class="Toolbox.Tools.CommandRunner.CommandWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="运行命令"
        Width="780" Height="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        Background="#FFF6F7F9">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- shell 选择 -->
            <RowDefinition Height="Auto" />   <!-- 输入 -->
            <RowDefinition Height="Auto" />   <!-- 将要执行的命令行 -->
            <RowDefinition Height="*" />      <!-- 输出 -->
            <RowDefinition Height="Auto" />   <!-- 按钮 -->
        </Grid.RowDefinitions>

        <!-- ===== shell 选择 ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="用哪个" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="ShellCombo" Grid.Column="1" Width="230" Height="26" SelectedIndex="0"
                      SelectionChanged="OnShellChanged">
                <ComboBoxItem Content="命令提示符（cmd）" />
                <ComboBoxItem Content="PowerShell" />
            </ComboBox>

            <TextBlock x:Name="ShellHint" Grid.Column="2" VerticalAlignment="Center"
                       Margin="12,0,0,0" FontSize="12" Foreground="#FF8A94A6"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- ===== 命令输入 ===== -->
        <TextBlock Grid.Row="1" Margin="0,12,0,5" Foreground="#FF8A94A6" FontSize="12"
                   Text="要执行的命令（Ctrl+Enter 执行；直接回车是换行，方便写多行）" />

        <TextBox x:Name="CommandBox" Grid.Row="1" Margin="0,30,0,0"
                 Height="110"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Microsoft YaHei UI, monospace"
                 FontSize="13"
                 Padding="8"
                 BorderBrush="#FFD5D9E0" BorderThickness="1" />

        <!-- ===== 将要执行的命令行（透明化，让用户能核对） ===== -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="9" CornerRadius="4"
                Background="#FFFFF8E6" BorderBrush="#FFE8D9A8" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="将要执行（原样显示，可核对）" FontSize="11" Foreground="#FF8A7A3B" />
                <TextBlock x:Name="PreviewText" Margin="0,4,0,0"
                           FontFamily="Consolas, monospace" FontSize="12"
                           Foreground="#FF5C5233" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ===== 输出 ===== -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="StatusText" Grid.Row="0" Foreground="#FF8A94A6" FontSize="12"
                       Margin="0,0,0,5" Text="还没执行。" />

            <TextBox x:Name="OutputBox" Grid.Row="1"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Microsoft YaHei UI, monospace"
                     FontSize="12"
                     Padding="8"
                     Background="#FF1E2228"
                     Foreground="#FFD8DEE9"
                     BorderBrush="#FFD5D9E0" BorderThickness="1" />
        </Grid>

        <!-- ===== 按钮 ===== -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                       Foreground="#FFB08800" TextWrapping="Wrap"
                       Text="⚠ 命令会以你的身份真实执行，没有沙箱。执行前请核对上面的命令行。" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RunBtn" Content="执行" Width="96" Height="32" Margin="0,0,8,0" />
                <Button x:Name="CancelBtn" Content="取消" Width="72" Height="32" Margin="0,0,8,0" IsEnabled="False" />
                <Button x:Name="CopyOutputBtn" Content="复制输出" Width="88" Height="32" Margin="0,0,8,0" />
                <Button x:Name="CloseBtn" Content="关闭" Width="72" Height="32" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

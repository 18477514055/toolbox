<Window x:Class="Toolbox.Tools.QrCode.QrWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="二维码工具"
        Width="820" Height="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        Background="#FFF6F7F9">

    <TabControl Margin="10">
        <!-- ================= 生成 ================= -->
        <TabItem Header="生成二维码">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="要编码的内容（文字 / 链接）"
                           Foreground="#FF8A94A6" FontSize="12" Margin="0,0,0,6" />

                <TextBox x:Name="ContentBox" Grid.Row="1" Grid.Column="0"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="8" FontSize="14"
                         BorderBrush="#FFD5D9E0" BorderThickness="1" />

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,22,0,0">
                    <TextBlock Text="纠错等级" Foreground="#FF8A94A6" FontSize="12" />
                    <ComboBox x:Name="EccCombo" Height="26" Margin="0,4,0,0" SelectedIndex="1">
                        <ComboBoxItem Content="M —— 约 15%（推荐）" />
                        <ComboBoxItem Content="L —— 约 7%（能装更多）" />
                        <ComboBoxItem Content="Q —— 约 25%" />
                        <ComboBoxItem Content="H —— 约 30%（最耐污损）" />
                    </ComboBox>

                    <TextBlock Text="图片边长（像素）" Foreground="#FF8A94A6" FontSize="12" Margin="0,12,0,0" />
                    <TextBox x:Name="SizeBox" Height="26" Margin="0,4,0,0" Text="512"
                             VerticalContentAlignment="Center" />

                    <Button x:Name="GenerateBtn" Content="生成" Height="32" Margin="0,16,0,0" />
                    <Button x:Name="SaveBtn" Content="保存为 PNG…" Height="30" Margin="0,8,0,0" IsEnabled="False" />
                    <Button x:Name="CopyImageBtn" Content="复制图片到剪贴板" Height="30" Margin="0,8,0,0" IsEnabled="False" />

                    <TextBlock x:Name="GenStatus" Margin="0,12,0,0" FontSize="12"
                               Foreground="#FF8A94A6" TextWrapping="Wrap"
                               Text="输入内容后点「生成」。" />
                </StackPanel>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Margin="0,12,0,0" Padding="8" Background="#FFFFFFFF"
                        BorderBrush="#FFD5D9E0" BorderThickness="1" CornerRadius="4">
                    <TextBlock x:Name="GenHint" TextWrapping="Wrap" FontSize="12" Foreground="#FF8A94A6"
                               Text="生成的二维码可以用手机扫，也可以「保存为 PNG」或「复制到剪贴板」。纠错等级越高越耐污损，但能装的内容更少。" />
                </Border>
            </Grid>
        </TabItem>

        <!-- ================= 扫描 ================= -->
        <TabItem Header="扫描屏幕二维码">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#FF8A94A6" FontSize="12"
                           Text="点「框选屏幕区域」→ 拖拽框住二维码 → 自动识别。也可以先把图片存成文件再选。" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="ScanScreenBtn" Content="框选屏幕区域" Width="120" Height="30" />
                    <Button x:Name="ScanFileBtn" Content="从图片文件…" Width="110" Height="30" Margin="8,0,0,0" />
                    <Button x:Name="CopyResultBtn" Content="复制结果" Width="88" Height="30" Margin="8,0,0,0" />
                </StackPanel>

                <TextBox x:Name="ScanResultBox" Grid.Row="2" Margin="0,12,0,0"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         Padding="8" FontSize="14"
                         BorderBrush="#FFD5D9E0" BorderThickness="1" />

                <Border Grid.Row="3" Margin="0,12,0,0" Padding="8" Background="#FFFFFFFF"
                        BorderBrush="#FFD5D9E0" BorderThickness="1" CornerRadius="4">
                    <TextBlock x:Name="ScanStatus" TextWrapping="Wrap" FontSize="12"
                               Foreground="#FF8A94A6"
                               Text="⚠ 本工具的扫描只支持「屏幕上截取的、完整正对的」二维码（不做透视校正、不做纠错译码）。拍照的、倾斜的、有污损的二维码请用手机扫。" />
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</Window>

<Window x:Class="Toolbox.Tools.HashCheck.HashCheckWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="哈希校验"
        Width="880" Height="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        Background="#FFF6F7F9">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 文件选择 -->
            <RowDefinition Height="Auto" />   <!-- 算法 + 进度 -->
            <RowDefinition Height="Auto" />   <!-- 结果 -->
            <RowDefinition Height="Auto" />   <!-- 比对 -->
            <RowDefinition Height="*" />      <!-- 说明 -->
            <RowDefinition Height="Auto" />   <!-- 按钮 -->
        </Grid.RowDefinitions>

        <!-- ===== 文件选择 ===== -->
        <GroupBox Grid.Row="0" Header="文件" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="文件 A" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="FileABox" Grid.Row="0" Grid.Column="1" Height="26"
                         VerticalContentAlignment="Center" />
                <Button x:Name="BrowseABtn" Grid.Row="0" Grid.Column="2" Content="浏览…" Width="72" Height="26" Margin="8,0,0,0" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="文件 B" VerticalAlignment="Center" Margin="0,8,8,0" />
                <TextBox x:Name="FileBBox" Grid.Row="1" Grid.Column="1" Height="26" Margin="0,8,0,0"
                         VerticalContentAlignment="Center"
                         ToolTip="可选。填了就比对两个文件是否一致。" />
                <Button x:Name="BrowseBBtn" Grid.Row="1" Grid.Column="2" Content="浏览…" Width="72" Height="26" Margin="8,8,0,0" />

                <Button x:Name="ClearBBtn" Grid.Row="1" Grid.Column="3" Content="清空" Width="60" Height="26" Margin="6,8,0,0"
                        ToolTip="清空文件 B（回到单文件模式）" />
            </Grid>
        </GroupBox>

        <!-- ===== 算法 + 进度 ===== -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="算法" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="AlgoCombo" Grid.Column="1" Height="26" SelectedIndex="1">
                <ComboBoxItem Content="SHA256（推荐）" />
                <ComboBoxItem Content="MD5" />
                <ComboBoxItem Content="SHA1" />
                <ComboBoxItem Content="SHA512" />
            </ComboBox>

            <ProgressBar x:Name="Progress" Grid.Column="2" Height="8" Margin="14,0,0,0"
                         VerticalAlignment="Center" Minimum="0" Maximum="1" />
        </Grid>

        <!-- ===== 结果 ===== -->
        <GroupBox Grid.Row="2" Header="计算结果" Margin="0,10,0,0" Padding="10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HashBox" Grid.Column="0" Height="28" IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             FontFamily="Consolas, monospace" FontSize="14" />
                    <Button x:Name="CopyHashBtn" Grid.Column="1" Content="复制" Width="68" Height="28" Margin="8,0,0,0" />
                </Grid>
                <TextBlock x:Name="HashInfoText" Margin="0,8,0,0" Foreground="#FF8A94A6" FontSize="12"
                           Text="选择一个文件后点「计算」。" TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <!-- ===== 比对期望值 ===== -->
        <GroupBox Grid.Row="3" Header="与期望值比对（把下载站给的校验值粘进来）" Margin="0,10,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ExpectedBox" Grid.Column="0" Height="28"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas, monospace"
                         ToolTip="粘贴 MD5 / SHA1 / SHA256 / SHA512，会自动识别算法" />
                <Button x:Name="VerifyBtn" Grid.Column="1" Content="比对" Width="68" Height="28" Margin="8,0,0,0" />
            </Grid>
        </GroupBox>

        <!-- ===== 结论 ===== -->
        <Border Grid.Row="4" Margin="0,10,0,0" Padding="10" CornerRadius="4" Background="#FFFFFFFF"
                BorderBrush="#FFD5D9E0" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ConclusionText" TextWrapping="Wrap" FontSize="13"
                           Foreground="#FF1F2329"
                           Text="说明：MD5 / SHA1 只能用于校验文件是否损坏，不能用于判断文件是否被恶意篡改（它们已被证明可以构造碰撞）。要防篡改用 SHA256 或更高级别。" />
            </ScrollViewer>
        </Border>

        <!-- ===== 按钮 ===== -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ComputeBtn" Content="计算" Width="96" Height="32" Margin="0,0,8,0" />
            <Button x:Name="CancelBtn" Content="取消" Width="76" Height="32" Margin="0,0,8,0" IsEnabled="False" />
            <Button x:Name="CloseBtn" Content="关闭" Width="76" Height="32" />
        </StackPanel>
    </Grid>
</Window>

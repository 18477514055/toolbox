<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Verify</AssemblyName>
    <RootNamespace>Verify</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- 直接链接被测源码：验的就是真源码，不是复制品 -->
    <Compile Include="..\..\src\Toolbox\Tools\Clipboard\DateRangeFilter.cs" />
    <Compile Include="..\..\src\Toolbox\Tools\Ai\LanguageDetector.cs" />
    <Compile Include="..\..\src\Toolbox\Tools\Convert\FileNaming.cs" />
    <Compile Include="..\..\src\Toolbox\Core\ScreenCoordinateMapper.cs" />
    <Compile Include="..\..\src\Toolbox\Core\NativeMethods.cs" />
  </ItemGroup>

</Project>

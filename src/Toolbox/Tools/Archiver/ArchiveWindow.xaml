<Window x:Class="Toolbox.Tools.Archiver.ArchiveWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量打包"
        Width="720" Height="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        Background="#FFF6F7F9"
        AllowDrop="True">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 要打包的东西 ===== -->
        <TextBlock Grid.Row="0" Foreground="#FF8A94A6" FontSize="12"
                   Text="要打包的文件 / 文件夹（可以直接从资源管理器拖进来，或框选后 Ctrl+C 再点「从剪贴板载入」）" />

        <ListBox x:Name="SourceList" Grid.Row="1" Height="150" Margin="0,5,0,0"
                 BorderBrush="#FFD5D9E0" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" FontSize="12" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="AddFilesBtn" Content="添加文件…" Width="96" Height="28" />
            <Button x:Name="AddFolderBtn" Content="添加文件夹…" Width="104" Height="28" Margin="8,0,0,0" />
            <Button x:Name="FromClipboardBtn" Content="从剪贴板载入" Width="116" Height="28" Margin="8,0,0,0" />
            <Button x:Name="RemoveBtn" Content="移除选中" Width="88" Height="28" Margin="8,0,0,0" />
            <Button x:Name="ClearBtn" Content="清空" Width="64" Height="28" Margin="8,0,0,0" />
        </StackPanel>

        <!-- ===== 选项 ===== -->
        <GroupBox Grid.Row="3" Header="打包选项" Margin="0,12,0,0" Padding="10">
            <StackPanel>
                <!-- 格式 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="格式" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <RadioButton x:Name="ZipRadio" Content="ZIP（零依赖，推荐）" IsChecked="True"
                                 VerticalAlignment="Center" Checked="OnFormatChanged" />
                    <RadioButton x:Name="RarRadio" Content="RAR（需要 WinRAR）" Margin="20,0,0,0"
                                 VerticalAlignment="Center" Checked="OnFormatChanged" />
                </StackPanel>

                <TextBlock x:Name="FormatHint" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="#FF8A94A6" Text="ZIP 用系统自带能力，不需要装任何东西。" />

                <!-- 放哪 -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="放到" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <RadioButton x:Name="SameFolderRadio" Content="和文件放在一起" IsChecked="True"
                                 VerticalAlignment="Center" Checked="OnDestinationChanged" />
                    <RadioButton x:Name="ConfiguredFolderRadio" Content="放到设置里指定的目录" Margin="20,0,0,0"
                                 VerticalAlignment="Center" Checked="OnDestinationChanged" />
                </StackPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputDirBox" Grid.Column="0" Height="26"
                             VerticalContentAlignment="Center"
                             IsEnabled="False" />
                    <Button x:Name="BrowseDirBtn" Grid.Column="1" Content="浏览…" Width="72" Height="26"
                            Margin="8,0,0,0" IsEnabled="False" />
                    <Button x:Name="SaveDirBtn" Grid.Column="2" Content="设为默认" Width="80" Height="26"
                            Margin="8,0,0,0" IsEnabled="False"
                            ToolTip="把这个目录存进设置，以后默认用它" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- ===== 底部状态 + 按钮 ===== -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="#FF1F2329" FontSize="12"
                       Text="添加要打包的文件，然后点「开始打包」。" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="PackBtn" Content="开始打包" Width="96" Height="32" Margin="0,0,8,0" />
                <Button x:Name="OpenResultBtn" Content="打开所在位置" Width="112" Height="32" Margin="0,0,8,0" IsEnabled="False" />
                <Button x:Name="CloseBtn" Content="关闭" Width="72" Height="32" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

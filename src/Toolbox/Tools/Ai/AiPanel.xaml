<Window x:Class="Toolbox.Tools.Ai.AiPanel"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷 AI · 桌面工具箱"
        Width="880" Height="760"
        MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F6F8"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Sec" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF1F2329" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF8A94A6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#FF2970D1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 读取来源 -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="读取方式" Style="{StaticResource Sec}" VerticalAlignment="Center" />
                    <RadioButton x:Name="ModeWindow" Content="整窗口（按热键就读当前页面）"
                                 IsChecked="True" GroupName="mode" Margin="14,0,0,0" VerticalAlignment="Center" />
                    <RadioButton x:Name="ModeSelection" Content="选中（只读我选中的那一段）"
                                 GroupName="mode" Margin="14,0,0,0" VerticalAlignment="Center" />
                    <Button x:Name="GrabBtn" Content="读取" Margin="18,0,0,0" />
                </StackPanel>

                <TextBlock x:Name="TargetInfo" Style="{StaticResource Hint}" Margin="0,8,0,0" />

                <CheckBox x:Name="MainOnlyBox" Content="整窗口时只取主内容区（自动去掉首尾的导航 / 页脚短行）"
                          IsChecked="True" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- 输入区标题 -->
        <Grid Grid.Row="1" Margin="2,0,2,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="将要送出的文本" Style="{StaticResource Sec}" />
                <TextBlock x:Name="InputInfo" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ClearBtn" Content="清空" Background="#FF9AA4B2" />
            </StackPanel>
        </Grid>

        <!-- 输入区 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <TextBox x:Name="Input"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="6" />
        </Border>

        <!-- 操作 -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TranslateBtn" Content="翻译（中英双向，自动判方向）" Background="#FF2970D1" />
                    <Button x:Name="SummarizeBtn" Content="总结" Background="#FF12A150" />
                    <Button x:Name="ClipboardBtn" Content="翻译剪贴板内容（只读，不改动剪贴板）" Background="#FF6B7280" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="提问" VerticalAlignment="Center" Width="40" Foreground="#FF4E5969" />
                    <TextBox x:Name="QuestionBox" Width="560" VerticalAlignment="Center"
                             ToolTip="针对上面的内容提问；留空则直接问模型" />
                    <Button x:Name="AskBtn" Content="提问" Background="#FF6B7280" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock x:Name="DirectionInfo" Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="翻译方向会按输入内容自动判断（中文为主→译成英文；英文为主→译成中文），并明确写进提示词。" />
            </StackPanel>
        </Border>

        <!-- 结果标题 -->
        <Grid Grid.Row="4" Margin="2,4,2,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="结果" Style="{StaticResource Sec}" />
                <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CopyBtn" Content="复制结果" Background="#FF6B7280" />
                <Button x:Name="CancelBtn" Content="停止" Background="#FFE03B3B" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <!-- 结果区 -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Padding="6">
            <TextBox x:Name="Output"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="6" />
        </Border>

        <Border Grid.Row="6" Style="{StaticResource Card}">
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}"
                       Text="模型跑在本机（Ollama），数据不出这台机器。" />
        </Border>
    </Grid>
</Window>

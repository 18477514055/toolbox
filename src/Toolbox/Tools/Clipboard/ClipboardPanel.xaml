<Window x:Class="Toolbox.Tools.Clipboard.ClipboardPanel"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷剪贴板"
        Width="580" Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Border Background="#F9FFFFFF" CornerRadius="10" BorderBrush="#26000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.20" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 搜索 -->
            <Grid Grid.Row="0" Margin="12,12,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Background="#FFEFF1F4" CornerRadius="7" Padding="9,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Width="330" />

                        <!-- 日期筛选：与关键字是「与」的关系，两个条件叠加生效 -->
                        <ComboBox x:Name="DateFilter"
                                  Width="112"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  SelectedIndex="0"
                                  SelectionChanged="OnDateFilterChanged">
                            <ComboBoxItem Content="全部时间" />
                            <ComboBoxItem Content="今天" />
                            <ComboBoxItem Content="昨天" />
                            <ComboBoxItem Content="最近 7 天" />
                            <ComboBoxItem Content="最近 30 天" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Column="1" x:Name="CountText"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           FontSize="12"
                           Foreground="#FF8A94A6" />
            </Grid>

            <!-- 列表（虚拟化：1000 条也不卡） -->
            <ListBox Grid.Row="1"
                     x:Name="List"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="6,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="7"
                                            Padding="8,6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFEFF3F9" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#282970D1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 图标 / 缩略图（二选一，用 Visibility 切换，避免写转换器） -->
                            <Grid Grid.Column="0" Width="40" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Icon}"
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IconVisibility}" />
                                <Border Visibility="{Binding ThumbVisibility}"
                                        CornerRadius="4"
                                        Background="#FFEFF1F4"
                                        Padding="1">
                                    <Image Source="{Binding Thumb}"
                                           Height="34"
                                           MaxWidth="52"
                                           Stretch="Uniform" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13"
                                           Foreground="#FF1F2329"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="11"
                                           Foreground="#FF8A94A6"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PinText}"
                                           FontSize="12"
                                           Margin="0,0,6,0"
                                           Foreground="#FFE0A33B" />
                                <TextBlock Text="{Binding TimeText}"
                                           FontSize="11"
                                           Foreground="#FFA8B0BC" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" Background="#FFF7F8FA" Padding="14,9" CornerRadius="0,0,10,10">
                <TextBlock FontSize="12" Foreground="#FF8A94A6" TextWrapping="Wrap"
                           Text="🖱 右键 = 直接复制　回车 = 复制　Esc = 关闭　↑↓ = 选择　Ctrl+D / Ctrl+Delete = 删除　Ctrl+P = 置顶&#10;文件和图片那一行显示的是它的原位置" />
            </Border>
        </Grid>
    </Border>
</Window>

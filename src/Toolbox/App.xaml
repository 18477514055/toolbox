<Application x:Class="Toolbox.App"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!--
        浅色主题：整个工具箱按浅色设计（与开发环境的 IDE 主题一致）。
        所有面板统一用这里的画刷，避免每个窗口各调各的颜色。
    -->
    <Application.Resources>

        <SolidColorBrush x:Key="PageBg" Color="#FFF5F6F8" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FF1F2329" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FF4E5969" />
        <SolidColorBrush x:Key="TextMuted" Color="#FF8A94A6" />
        <SolidColorBrush x:Key="Accent" Color="#FF2970D1" />
        <SolidColorBrush x:Key="AccentSoft" Color="#1F2970D1" />
        <SolidColorBrush x:Key="Danger" Color="#FFE03B3B" />
        <SolidColorBrush x:Key="Success" Color="#FF12A150" />
        <SolidColorBrush x:Key="HairLine" Color="#1A000000" />

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#FFEDEFF2" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

    </Application.Resources>
</Application>

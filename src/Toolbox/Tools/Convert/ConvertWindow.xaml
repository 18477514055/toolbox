<Window x:Class="Toolbox.Tools.Convert.ConvertWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="格式转换 · 桌面工具箱"
        Width="1000" Height="660"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F6F8"
        AllowDrop="True"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#FF2970D1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddFilesBtn" Content="添加文件…" />
                    <Button x:Name="AddFolderBtn" Content="添加文件夹…" Background="#FF6B7280" />
                    <Button x:Name="ClearBtn" Content="清空列表" Background="#FF9AA4B2" />
                    <TextBlock Text="　（也可以把文件直接拖进这个窗口）" VerticalAlignment="Center"
                               FontSize="11" Foreground="#FFA8B0BC" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="输出目录" VerticalAlignment="Center" Width="66" />
                    <TextBox x:Name="OutputDirBox" Width="620" VerticalAlignment="Center" />
                    <Button x:Name="PickOutputBtn" Content="选择…" Background="#FF6B7280" Margin="8,0,0,0" />
                    <Button x:Name="OpenOutputBtn" Content="打开" Background="#FF9AA4B2" Margin="6,0,0,0" />
                </StackPanel>

                <TextBlock x:Name="BackendInfo" FontSize="11" Foreground="#FF8A94A6" Margin="0,8,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 任务列表 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <ListBox x:Name="Jobs"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="2,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" FontSize="13" Foreground="#FF1F2329"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="#FFA8B0BC"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding Kind}" VerticalAlignment="Center"
                                       FontSize="12" Foreground="#FF8A94A6" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="→" VerticalAlignment="Center" Foreground="#FFA8B0BC" Margin="0,0,8,0" />
                                <ComboBox Width="92" ItemsSource="{Binding Targets}"
                                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" />
                            </StackPanel>

                            <TextBlock Grid.Column="3" Text="{Binding TargetHint}" VerticalAlignment="Center"
                                       FontSize="11" Foreground="#FFA8B0BC" Margin="10,0,10,0" />

                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#FF4E5969"
                                           TextTrimming="CharacterEllipsis" />
                                <ProgressBar Height="4" Margin="0,4,0,0" IsIndeterminate="True"
                                             Visibility="{Binding RunningVisibility}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 底部 -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryText" Foreground="#FF4E5969" Text="还没有任务。" />
                    <TextBlock x:Name="DetailText" FontSize="11" Foreground="#FF8A94A6" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartBtn" Content="开始转换" Background="#FF12A150" Padding="20,6" />
                    <Button x:Name="CancelBtn" Content="取消" Background="#FFE03B3B" IsEnabled="False" />
                    <Button x:Name="OpenResultBtn" Content="打开输出目录" Background="#FF6B7280" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
